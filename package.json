{
  "name": "agent-town",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun run --bun vitest run",
    "typecheck": "bun run --bun tsc -b",
    "serve": "bun server/index.ts",
    "build": "bun run --bun vite build",
    "start": "bun run build && bun run serve",
    "dev": "bun run --no-orphans --parallel dev:server dev:web",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "bun run --bun vite",
    "check": "bun run test && bun run typecheck && bun run build",
    "format": "bun run --bun prettier --write .",
    "format:check": "bun run --bun prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@hono/bun": "^1.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "i18next": "^26.6.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.1.10",
    "suncalc": "2.1.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
